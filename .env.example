# Copier ce fichier en .env (non versionné) et renseigner les valeurs.
# Mot de passe de l'administrateur Grafana (obligatoire)
GF_ADMIN_PASSWORD=
# Adresse de l'API Docker (facultatif, défaut unix:///var/run/docker.sock)
# Décommenter si besoin, ex. macOS Docker Desktop : unix:///Users/<vous>/.docker/run/docker.sock
# TF_VAR_docker_host=
