<!doctype html>
<!-- {{ ansible_managed }} -->
{% set accent = '#10b981' if env_name == 'prod' else '#3b82f6' %}
{% set domains = [
  {'name': 'Capteurs IoT', 'desc': 'Relevés des capteurs répartis dans la ville',
   'icon': '<circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/>'},
  {'name': 'Trafic', 'desc': 'Flux de circulation et congestion en temps réel',
   'icon': '<rect x="7" y="2" width="10" height="20" rx="3"/><circle cx="12" cy="7" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="17" r="1.5"/>'},
  {'name': 'Pollution', 'desc': "Qualité de l'air : particules, NO₂, ozone",
   'icon': '<path d="M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7"/>'},
  {'name': 'Bruit', 'desc': 'Niveaux sonores par quartier',
   'icon': '<path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/>'},
  {'name': 'Incidents', 'desc': 'Signalements et interventions sur la voirie',
   'icon': '<path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4M12 17h.01"/>'},
  {'name': 'Énergie', 'desc': 'Consommation des bâtiments et éclairage public',
   'icon': '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>'},
] %}
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{{ app_title }} [{{ env_name }}]</title>
  <style>
    :root {
      --bg: #0b1120; --surface: #111a2e; --border: #1e2a44;
      --text: #e2e8f0; --muted: #8b9ab5; --accent: {{ accent }};
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; color: var(--text);
      font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background:
        radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
        linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 48px 48px,
        linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 48px 48px,
        var(--bg);
      background-attachment: fixed;
    }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 0; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; letter-spacing: .2px; }
    .brand svg { color: var(--accent); }
    .badge {
      display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px;
      font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .6px;
      color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    }
    .hero { padding: 56px 0 40px; }
    .status { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; }
    .dot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 #22c55e88; animation: pulse 2s infinite; }
    @keyframes pulse { 70% { box-shadow: 0 0 0 10px #22c55e00; } 100% { box-shadow: 0 0 0 0 #22c55e00; } }
    h1 { margin: 14px 0 10px; font-size: clamp(36px, 6vw, 60px); line-height: 1.05; letter-spacing: -1.2px; }
    h1 span { color: var(--accent); }
    .lead { max-width: 640px; margin: 0; color: var(--muted); font-size: 18px; }
    h2 { margin: 0 0 16px; font-size: 13px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .card {
      padding: 18px; border-radius: 14px; background: color-mix(in srgb, var(--surface) 88%, transparent);
      border: 1px solid var(--border); transition: border-color .2s, transform .2s;
    }
    .card:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); transform: translateY(-2px); }
    .icon {
      display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 12px; border-radius: 10px;
      color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
    }
    .card h3 { margin: 0 0 4px; font-size: 16px; }
    .card p { margin: 0; color: var(--muted); font-size: 14px; }
    .layout { display: grid; grid-template-columns: 1fr 320px; gap: 28px; padding-bottom: 48px; }
    dl { margin: 0; display: grid; grid-template-columns: auto 1fr; }
    dt, dd { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
    dt { color: var(--muted); padding-right: 16px; }
    dd { text-align: right; font-family: ui-monospace, "Cascadia Code", Consolas, monospace; overflow-wrap: anywhere; }
    dl > :nth-last-child(-n+2) { border-bottom: 0; }
    footer { padding: 20px 0 32px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }
    footer b { color: var(--text); font-weight: 600; }
    @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } .hero { padding-top: 32px; } }
    @media (prefers-reduced-motion: reduce) { .dot { animation: none; } .card { transition: none; } }
  </style>
</head>
<body data-env="{{ env_name }}">
  <div class="wrap">
    <header>
      <div class="brand">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21h18M5 21V10l4-3v14M9 21V4h6v17M15 21V9l4 2v10"/><path d="M11.5 7h1M11.5 10h1M11.5 13h1"/>
        </svg>
        UrbanHub
      </div>
      <span class="badge">Environnement : {{ env_name }}</span>
    </header>

    <section class="hero">
      <div class="status"><span class="dot"></span> Service opérationnel</div>
      <h1>Urban<span>Hub</span></h1>
      <p class="lead">{{ app_title }} : collecte, analyse et exploitation des données d'une ville moderne pour piloter une plateforme Smart City.</p>
    </section>

    <div class="layout">
      <section>
        <h2>Domaines de données</h2>
        <div class="grid">
{% for d in domains %}
          <article class="card">
            <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d.icon }}</svg></div>
            <h3>{{ d.name }}</h3>
            <p>{{ d.desc }}</p>
          </article>
{% endfor %}
        </div>
      </section>

      <aside>
        <h2>Instance</h2>
        <div class="card">
          <dl>
            <dt>Nom</dt><dd>{{ inventory_hostname }}</dd>
            <dt>Adresse privée</dt><dd>{{ instance_ip }}</dd>
            <dt>Gabarit</dt><dd>{{ instance_type }}</dd>
            <dt>Système</dt><dd>{{ ansible_distribution }} {{ ansible_distribution_version }}</dd>
            <dt>Déployé le</dt><dd>{{ ansible_date_time.iso8601 }}</dd>
          </dl>
        </div>
      </aside>
    </div>

    <footer>
      Infrastructure décrite en code : <b>Terraform</b> crée l'instance, <b>Ansible</b> la configure, <b>Prometheus</b> et <b>Grafana</b> la supervisent.
    </footer>
  </div>
</body>
</html>
